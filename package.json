{
  "name": "statsedge-v0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "test:integration:ephemeral": "node --test tests/integration/bootstrap-control.contract.test.mjs tests/integration/ephemeral-roles.real.test.mjs tests/integration/scan-result-set-integrity.real.test.mjs tests/integration/scan-result-set-concurrency.real.test.mjs tests/integration/scan-execution-lifecycle.real.test.mjs tests/integration/scan-result-set-finalization-publication.real.test.mjs tests/integration/scan-result-set-published-read.real.test.mjs tests/integration/schema-parity.real.test.mjs",
    "test:integration:ephemeral:reset": "bash scripts/reset-ephemeral-db.sh && npm run test:integration:ephemeral",
    "test:integration:legacy": "vitest run tests/integration/check-daily-bars-cap.real.test.mjs tests/integration/check-scan-finalize.real.test.mjs tests/integration/check-signal-contradictions.real.test.mjs tests/integration/coverage-scan-summary.real.test.mjs tests/integration/diagnose-isolation.test.mjs tests/integration/scan-coverage-breakdown.real.test.mjs",
    "test:patterns": "node --loader ./scripts/loader.mjs scripts/pattern-detector-regression.mjs",
    "test:filters": "node --loader ./scripts/loader.mjs scripts/filter-regression-test.mjs && FILTER_CONTRACT_MARKDOWN=0 FILTER_CONTRACT_QUIET=1 node --loader ./scripts/loader.mjs scripts/filter-contract-audit.mjs && FILTER_LAYER_CONTRACT_MARKDOWN=0 FILTER_LAYER_CONTRACT_QUIET=1 node --loader ./scripts/loader.mjs scripts/filter-layer-contract-audit.mjs",
    "test:filters:ui": "node scripts/filter-ui-regression.mjs",
    "test:symbols": "node --no-warnings scripts/symbol-mapping-test.mjs",
    "audit:coherence": "node --env-file=.env.local scripts/data-coherence-audit.mjs",
    "audit:methodology": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/methodology-validation-audit.mjs",
    "audit:methodology:matrix": "METHODOLOGY_AUDIT_MARKDOWN=1 node --env-file=.env.local --loader ./scripts/loader.mjs scripts/methodology-validation-audit.mjs",
    "audit:vcp:corpus": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/vcp-corpus-audit.mjs",
    "audit:vcp:depths": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/vcp-real-depth-audit.mjs",
    "audit:filters:contracts": "node --loader ./scripts/loader.mjs scripts/filter-contract-audit.mjs",
    "audit:filters:layers": "node --loader ./scripts/loader.mjs scripts/filter-layer-contract-audit.mjs",
    "audit:decisions": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/decision-readiness-audit.mjs",
    "audit:reliability": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/reliability-audit.mjs",
    "audit:metrics": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/metrics-audit.mjs",
    "audit:rc": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/rc-readiness-audit.mjs",
    "audit:postdeploy": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/post-deploy-observability-audit.mjs",
    "review:methodology": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/methodology-review-report.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "supabase:seed-settings": "node --env-file=.env.local scripts/seed-default-settings.mjs",
    "supabase:status": "node scripts/supabase-admin.mjs status",
    "supabase:schema": "node scripts/supabase-admin.mjs schema",
    "test:e2e": "node --import ./scripts/refactor-check/register.mjs scripts/e2e/run.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fflate": "^0.8.3",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  }
}
