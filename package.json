{
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node scripts/smoke-test.mjs && npm run test:patterns",
    "test:patterns": "node --loader ./scripts/loader.mjs scripts/pattern-detector-regression.mjs",
    "test:filters": "node --loader ./scripts/loader.mjs scripts/filter-regression-test.mjs",
    "test:filters:ui": "node scripts/filter-ui-regression.mjs",
    "test:symbols": "node --no-warnings scripts/symbol-mapping-test.mjs",
    "audit:coherence": "node --env-file=.env.local scripts/data-coherence-audit.mjs",
    "audit:methodology": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/methodology-validation-audit.mjs",
    "audit:methodology:matrix": "METHODOLOGY_AUDIT_MARKDOWN=1 node --env-file=.env.local --loader ./scripts/loader.mjs scripts/methodology-validation-audit.mjs",
    "review:methodology": "node --env-file=.env.local --loader ./scripts/loader.mjs scripts/methodology-review-report.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "supabase:seed-settings": "node --env-file=.env.local scripts/seed-default-settings.mjs",
    "supabase:status": "node scripts/supabase-admin.mjs status",
    "supabase:schema": "node scripts/supabase-admin.mjs schema"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fflate": "^0.8.3",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.2.6",
    "autoprefixer": "latest",
    "playwright": "^1.60.0",
    "postcss": "latest",
    "tailwindcss": "latest"
  }
}
