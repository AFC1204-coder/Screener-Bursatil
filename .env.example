# Supabase server-side persistence.
# Copy to .env.local locally and set the same values in Vercel Project Settings.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: lets one Supabase project hold several personal workspaces.
STATSEDGE_OWNER_ID=personal

# Optional: legacy persistence token for scripts/server callers (x-statsedge-token).
# El navegador usa cookie de sesión; no guardar este valor en localStorage.
STATSEDGE_API_TOKEN=

# Optional admin connector for running supabase/schema.sql from this repo.
# Create it in Supabase Account > Access Tokens. Never expose it in browser code.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Optional but useful for SEC EDGAR etiquette.
SEC_USER_AGENT=StatsEdge/0.1 personal research app contact@example.com

# Optional free historical chart fallback.
# Stooq currently requires a free personal CSV API key generated from its download page.
STOOQ_API_KEY=your-stooq-free-csv-key

# Planned optional free-tier providers. Leave empty until wired into the pipeline.
# Alpha Vantage is wired as an optional daily chart fallback after Yahoo/Stooq.
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# FMP is wired as an optional profile/fundamentals/ratios fallback.
FMP_API_KEY=your-fmp-key

# OpenFIGI is wired as an optional symbol/ISIN/FIGI resolver.
# It works anonymously with tighter limits; add a key for better rate limits.
OPENFIGI_API_KEY=your-openfigi-key

# Official/free universe sources.
# HKEX works without a key; override only if HKEX changes the public file path.
HKEX_SECURITIES_LIST_URL=https://www.hkex.com.hk/eng/services/trading/securities/securitieslists/ListOfSecurities.xlsx

# ESMA FIRDS is an opt-in Europe/EEA reference-universe adapter.
# It downloads large weekly XML files, filters equity ISIN/MIC/CFI rows, then
# resolves a capped number of ISINs to Yahoo-style symbols through OpenFIGI.
ESMA_FIRDS_ENABLED=0
ESMA_FIRDS_MAX_FILES=1
ESMA_FIRDS_SCAN_RECORD_LIMIT=750000
ESMA_FIRDS_REFERENCE_LIMIT_PER_MARKET=5000
ESMA_FIRDS_RESOLVE_LIMIT_PER_MARKET=25
ESMA_FIRDS_SEARCH_TIMEOUT_MS=12000
ESMA_FIRDS_DOWNLOAD_TIMEOUT_MS=90000

# FCA FIRDS is the separate UK reference-universe adapter.
# Same legal model as ESMA: internal hidden reference universe, capped OpenFIGI
# resolution, then OHLCV freshness gate before anything becomes scannable.
FCA_FIRDS_ENABLED=0
FCA_FIRDS_FILE_PREFIX=FULINS_E
FCA_FIRDS_MAX_FILES=1
FCA_FIRDS_SCAN_RECORD_LIMIT=750000
FCA_FIRDS_REFERENCE_LIMIT_PER_MARKET=5000
FCA_FIRDS_RESOLVE_LIMIT_PER_MARKET=25
FCA_FIRDS_SEARCH_TIMEOUT_MS=12000
FCA_FIRDS_DOWNLOAD_TIMEOUT_MS=90000

# J-Quants V2 is active when configured. V1 refresh token is a compatibility fallback.
JQUANTS_API_BASE_URL=https://api.jquants.com/v2
JQUANTS_API_KEY=your-jquants-v2-api-key
JQUANTS_V1_API_BASE_URL=https://api.jquants.com/v1
JQUANTS_REFRESH_TOKEN=your-jquants-v1-refresh-token
JQUANTS_ID_TOKEN=your-jquants-v1-id-token

# Planned optional providers for later phases.
FINNHUB_API_KEY=your-finnhub-key
TWELVE_DATA_API_KEY=your-twelve-data-key
MARKETSTACK_API_KEY=your-marketstack-key
EODHD_API_KEY=your-eodhd-key

# Optional: protect future cron/job endpoints.
CRON_SECRET=change-me

# VCP unificado (research v7 + gates). 1 = mismo motor en scan/ficha; reiniciar servidor tras cambiar.
STATSEDGE_VCP_UNIFIED=1
