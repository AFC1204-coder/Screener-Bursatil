# Supabase server-side persistence.
# Copy to .env.local locally and set the same values in Vercel Project Settings.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: lets one Supabase project hold several personal workspaces.
STATSEDGE_OWNER_ID=personal

# Optional admin connector for running supabase/schema.sql from this repo.
# Create it in Supabase Account > Access Tokens. Never expose it in browser code.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Optional but useful for SEC EDGAR etiquette.
SEC_USER_AGENT=StatsEdge/0.1 personal research app contact@example.com

# Optional free historical chart fallback.
# Stooq currently requires a free personal CSV API key generated from its download page.
STOOQ_API_KEY=your-stooq-free-csv-key

# Planned optional free-tier providers. Leave empty until wired into the pipeline.
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FMP_API_KEY=your-fmp-key
