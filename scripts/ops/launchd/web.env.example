# Plantilla SIN secretos del entorno del servidor web (y de daily-health.sh).
# En el Mini:
#   mkdir -p ~/.config/statsedge && chmod 700 ~/.config/statsedge
#   cp scripts/ops/launchd/web.env.example ~/.config/statsedge/web.env
#   chmod 600 ~/.config/statsedge/web.env && nano ~/.config/statsedge/web.env
# Formato: KEY=valor, sin "export", sin espacios alrededor del "=".
# Este archivo se lee con `source` desde bash: entrecomilla valores con espacios.

# --- Servidor ----------------------------------------------------------------
STATSEDGE_WEB_PORT=3000
# 127.0.0.1 = solo el propio Mini (y Tailscale serve, que hace de proxy).
# 0.0.0.0   = cualquier equipo de la LAN (ver runbook §3: con HTTP en LAN la
#             cookie Secure no se guarda y el login no se mantiene).
STATSEDGE_WEB_HOST=127.0.0.1

# --- Autenticación (obligatorio en producción) -------------------------------
# Token que se pega en la pantalla de acceso. openssl rand -hex 32
STATSEDGE_ACCESS_TOKEN=
# Firma de la cookie de sesión. Independiente del token. openssl rand -hex 32
STATSEDGE_SESSION_SECRET=
# Solo si se usan las rutas /api/cron/* (hoy no: los crons de Vercel se quitaron)
# CRON_SECRET=

# --- Base de datos (Postgres 17 local del Mini) --------------------------------
STATSEDGE_DB_MODE=pg
# Mismo Postgres que escribe el nocturno. En el Mini es local: 127.0.0.1:5432
# (el :15432 es el túnel SSH que se usa DESDE el portátil).
DATABASE_URL=postgresql://USUARIO@127.0.0.1:5432/statsedge
STATSEDGE_OWNER_ID=personal

# --- Opcionales que ya usa .env.local ------------------------------------------
# SEC_USER_AGENT="StatsEdge personal contacto@ejemplo.com"
# STATSEDGE_VCP_UNIFIED=

# --- Avisos y salud (scripts/ops/daily-health.sh, scripts/ops/notify.sh) --------
# Vacío = solo log. ntfy: https://ntfy.sh/<topic-largo-y-aleatorio> o tu servidor.
NOTIFY_URL=
# NOTIFY_TOKEN=
# NOTIFY_MIN_LEVEL=warn
# Conexión de solo lectura para data-health-check.mjs (si se omite, usa :55432
# local, que en el Mini NO existe: hay que definirla).
STATSEDGE_HEALTH_DATABASE_URL=postgresql://USUARIO@127.0.0.1:5432/statsedge
